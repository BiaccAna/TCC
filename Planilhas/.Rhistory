library(readxl)
library(openxlsx)
library(dplyr)
library(xlsx)
library(rio)
library(tidyr)
library(writexl)
library(stringr)
library(tibble)
library(forcats)
library(scales)
library(ggplot2)
library(iNEXT)
install.packages("iNEXT")
library(iNEXT)
# tamanho de letra pensado para pôster (base 24 pt)
theme_set(
theme_classic(
base_size = 40,
base_family = "Times New Roman"
)
)
DADOS <- DADOS %>%
mutate(
Especie      = word(str_trim(scientificName), 1, 2),   # junta subespécies na espécie
regiao_curta = str_remove(regiao, "^Região (d[aeo]s? )?")
)
g1
g1 <- ggplot(regioes, aes(x = valor, y = regiao_curta)) +
geom_col(fill = "#2E7D32", width = 0.7) +
geom_text(aes(label = number(valor, big.mark = ".")), hjust = -0.15, size = 7) +
facet_wrap(~ medida, scales = "free_x",
labeller = as_labeller(c(Registros = "Registros", Especies = "Espécies"))) +
scale_x_continuous(expand = expansion(mult = c(0, 0.3))) +
labs(x = NULL, y = NULL) +
theme(strip.background = element_blank(),
strip.text = element_text(face = "bold"))
regioes <- DADOS %>%
filter(!is.na(regiao_curta)) %>%
group_by(regiao_curta) %>%
summarise(Registros = n(), Especies = n_distinct(Especie), .groups = "drop") %>%
bind_rows(tibble(regiao_curta = "Noroeste Fluminense", Registros = 0L, Especies = 0L)) %>%
mutate(regiao_curta = fct_reorder(regiao_curta, Registros)) %>%
pivot_longer(c(Registros, Especies), names_to = "medida", values_to = "valor") %>%
mutate(medida = factor(medida, levels = c("Registros", "Especies")))
g1 <- ggplot(regioes, aes(x = valor, y = regiao_curta)) +
geom_col(fill = "#2E7D32", width = 0.7) +
geom_text(aes(label = number(valor, big.mark = ".")), hjust = -0.15, size = 7) +
facet_wrap(~ medida, scales = "free_x",
labeller = as_labeller(c(Registros = "Registros", Especies = "Espécies"))) +
scale_x_continuous(expand = expansion(mult = c(0, 0.3))) +
labs(x = NULL, y = NULL) +
theme(strip.background = element_blank(),
strip.text = element_text(face = "bold"))
g1 <- ggplot(regioes, aes(x = valor, y = regiao_curta)) +
geom_col(fill = "#2E7D32", width = 0.7) +
geom_text(aes(label = number(valor, big.mark = ".")), hjust = -0.15, size = 7) +
facet_wrap(~ medida, scales = "free_x",
labeller = as_labeller(c(Registros = "Registros", Especies = "Espécies"))) +
scale_x_continuous(expand = expansion(mult = c(0, 0.3))) +
labs(x = NULL, y = NULL) +
theme(strip.background = element_blank(),
strip.text = element_text(face = "bold"))
g1
# matriz: linhas = espécies, colunas = regiões, valores = nº de registros
mat_regioes <- DADOS %>%
filter(!is.na(regiao_curta)) %>%
count(regiao_curta, Especie) %>%
pivot_wider(names_from = regiao_curta, values_from = n, values_fill = 0) %>%
column_to_rownames("Especie")
rarefacao <- iNEXT(mat_regioes, q = 0, datatype = "abundance", nboot = 50)
g2 <- ggiNEXT(rarefacao, type = 1) +
scale_color_viridis_d() +
scale_fill_viridis_d() +
labs(x = "Número de registros", y = "Riqueza de espécies") +
theme(legend.position = "right")
g2
cobertura <- DADOS %>%
mutate(cobertura = fct_lump_prop(coberturaSolo, prop = 0.01, other_level = "Outras classes")) %>%
count(cobertura) %>%
mutate(pct = n / sum(n),
cobertura = fct_reorder(cobertura, pct))
g3 <- ggplot(cobertura, aes(x = pct, y = cobertura)) +
geom_col(fill = "#8D6E63", width = 0.7) +
geom_text(aes(label = percent(pct, accuracy = 0.1, decimal.mark = ",")),
hjust = -0.15, size = 7) +
scale_x_continuous(labels = percent, expand = expansion(mult = c(0, 0.2))) +
labs(x = "% dos registros", y = NULL)
g3 <- ggplot(cobertura, aes(x = pct, y = cobertura)) +
geom_col(fill = "#8D6E63", width = 0.7) +
geom_text(aes(label = percent(pct, accuracy = 0.1, decimal.mark = ",")),
hjust = -0.15, size = 7) +
scale_x_continuous(labels = percent, expand = expansion(mult = c(0, 0.2))) +
labs(x = "% dos registros", y = NULL)
g3
niveis_hab <- c("Especialista de Floresta", "Generalista",
"Especialista de Área Aberta", "Sem Classificação")
habitat <- DADOS %>%
filter(!is.na(regiao_curta)) %>%
group_by(regiao_curta) %>%
mutate(n_reg = n()) %>%
ungroup() %>%
mutate(
rotulo = fct_reorder(paste0(regiao_curta, "\n(n = ", number(n_reg, big.mark = "."), ")"), n_reg),
classificacaoFormiga = factor(classificacaoFormiga, levels = niveis_hab)
)
g4 <- ggplot(habitat, aes(y = rotulo, fill = classificacaoFormiga)) +
geom_bar(position = "fill", width = 0.7) +
scale_x_continuous(labels = percent, expand = expansion(mult = c(0, 0.02))) +
scale_fill_manual(values = c("Especialista de Floresta"     = "#2E7D32",
"Generalista"                  = "#F9A825",
"Especialista de Área Aberta"  = "#8D6E63",
"Sem Classificação"            = "grey70")) +
labs(x = "% dos registros", y = NULL, fill = NULL) +
theme(legend.position = "bottom") +
guides(fill = guide_legend(nrow = 2))
g4
g2 <- ggplot(curvas, aes(x = m, y = qD, color = Assemblage, fill = Assemblage)) +
geom_ribbon(aes(ymin = qD.LCL, ymax = qD.UCL), alpha = 0.15, color = NA) +
geom_line(linewidth = 1.5) +
geom_point(data = pontos, size = 5) +
scale_x_log10(labels = number_format(big.mark = ".")) +
scale_color_viridis_d() +
scale_fill_viridis_d() +
labs(x = "Número de registros (escala log)",
y = "Riqueza de espécies",
color = NULL, fill = NULL) +
theme(legend.position = "right")
g2 <- ggplot(curvas, aes(x = m, y = qD, color = Assemblage, fill = Assemblage)) +
geom_ribbon(aes(ymin = qD.LCL, ymax = qD.UCL), alpha = 0.15, color = NA) +
geom_line(linewidth = 1.5) +
geom_point(data = pontos, size = 5) +
scale_x_log10(labels = number_format(big.mark = ".")) +
scale_color_viridis_d() +
scale_fill_viridis_d() +
labs(x = "Número de registros (escala log)",
y = "Riqueza de espécies",
color = NULL, fill = NULL) +
theme(legend.position = "right")
mat_regioes <- DADOS %>%
filter(!is.na(regiao_curta)) %>%
count(regiao_curta, Especie) %>%
pivot_wider(
names_from = regiao_curta,
values_from = n,
values_fill = 0
) %>%
column_to_rownames("Especie")
set.seed(123)
rarefacao <- iNEXT(
mat_regioes,
q = 0,
datatype = "abundance",
nboot = 50
)
g2 <- ggiNEXT(rarefacao, type = 1) +
scale_color_viridis_d() +
scale_fill_viridis_d() +
labs(
x = "Número de registros",
y = "Riqueza de espécies"
) +
theme_classic(
base_size = 18,
base_family = "Times New Roman"
) +
theme(
axis.title = element_text(size = 20),
axis.text = element_text(size = 16),
legend.text = element_text(size = 16),
legend.title = element_text(size = 16),
legend.position = "bottom",
legend.direction = "horizontal",
legend.key.size = unit(0.8, "cm"),
legend.spacing.x = unit(0.4, "cm"),
plot.margin = margin(15, 15, 15, 15)
) +
guides(
color = guide_legend(nrow = 2),
fill = guide_legend(nrow = 2)
)
g2
g2
niveis_hab <- c(
"Especialista de Floresta",
"Generalista",
"Especialista de Área Aberta",
"Sem Classificação"
)
habitat <- DADOS %>%
filter(!is.na(regiao_curta)) %>%
group_by(regiao_curta) %>%
mutate(n_reg = n()) %>%
ungroup() %>%
mutate(
rotulo = fct_reorder(
paste0(
regiao_curta,
"\n(n = ",
number(n_reg, big.mark = "."),
")"
),
n_reg
),
classificacaoFormiga = factor(
classificacaoFormiga,
levels = niveis_hab
)
)
g4 <- ggplot(
habitat,
aes(
y = rotulo,
fill = classificacaoFormiga
)
) +
geom_bar(
position = "fill",
width = 0.7
) +
scale_x_continuous(
labels = percent,
expand = expansion(mult = c(0, 0.02))
) +
scale_fill_manual(
values = c(
"Especialista de Floresta" = "#2E7D32",
"Generalista" = "#F9A825",
"Especialista de Área Aberta" = "#8D6E63",
"Sem Classificação" = "grey70"
)
) +
labs(
x = "% dos registros",
y = NULL,
fill = NULL
) +
theme_classic(
base_size = 18,
base_family = "Times New Roman"
) +
theme(
axis.text.y = element_text(size = 16),
axis.text.x = element_text(size = 16),
axis.title.x = element_text(size = 18),
legend.position = "bottom",
legend.text = element_text(size = 15),
legend.key.size = unit(0.7, "cm"),
legend.spacing.x = unit(0.4, "cm"),
plot.margin = margin(10, 20, 10, 20)
) +
guides(
fill = guide_legend(
nrow = 2,
byrow = TRUE
)
)
g4
dados_grafico <- DADOS %>%
filter(
!is.na(regiao),
!is.na(coberturaSolo),
!is.na(classificacaoFormiga)
) %>%
mutate(
classificacaoFormiga = factor(
classificacaoFormiga,
levels = c(
"Especialista de Floresta",
"Especialista de Área Aberta",
"Generalista",
"Sem Classificação"
)
)
)
# Gráfico
g5 <- ggplot(
dados_grafico,
aes(
x = coberturaSolo,
fill = classificacaoFormiga
)
) +
geom_bar(
position = "fill",
width = 0.8
) +
facet_wrap(~ regiao, ncol = 2) +
scale_y_continuous(
labels = percent,
expand = expansion(mult = c(0, 0.02))
) +
scale_fill_manual(
values = c(
"Especialista de Floresta" = "#2E7D32",
"Especialista de Área Aberta" = "#8D6E63",
"Generalista" = "#F9A825",
"Sem Classificação" = "grey70"
)
) +
labs(
x = "Cobertura do solo",
y = "% dos registros",
fill = "Classificação"
) +
theme_classic(
base_size = 16,
base_family = "Times New Roman"
) +
theme(
axis.text.x = element_text(
angle = 45,
hjust = 1,
size = 12
),
axis.text.y = element_text(size = 13),
axis.title = element_text(size = 16),
strip.text = element_text(
size = 14,
face = "bold"
),
legend.position = "bottom",
legend.text = element_text(size = 13),
legend.title = element_text(size = 14),
plot.margin = margin(10, 15, 10, 15)
)
g5
